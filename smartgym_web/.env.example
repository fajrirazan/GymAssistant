# SmartGym AI — Environment Variables
# Salin file ini ke .env dan isi nilainya
# JANGAN commit file .env ke Git!

# ── Django Security ────────────────────────────────────────────
SECRET_KEY=ganti-dengan-secret-key-acak-yang-panjang
DEBUG=False
ALLOWED_HOSTS=yourdomain.up.railway.app,localhost

# ── Database Railway ───────────────────────────────────────────
# Railway akan mengisi DATABASE_URL secara otomatis.
# Tidak perlu diisi manual jika pakai Railway MySQL/PostgreSQL.
# DATABASE_URL=mysql://user:password@host:port/dbname
